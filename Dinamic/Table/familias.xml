<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : familias.xml
    Author     : Carlos Garcia Gomez
    Description:
        Structure for the familias table.
-->
<table>
    <column>
        <name>codfamilia</name>
        <type>character varying(8)</type>
        <null>NO</null>
    </column>
    <column>
        <name>codsubcuentacom</name>
        <type>character varying(15)</type>
    </column>
    <column>
        <name>codsubcuentairpfcom</name>
        <type>character varying(15)</type>
    </column>
    <column>
        <name>codsubcuentaven</name>
        <type>character varying(15)</type>
    </column>
    <column>
        <name>descripcion</name>
        <type>character varying(100)</type>
        <null>NO</null>
    </column>
    <column>
        <name>madre</name>
        <type>character varying(8)</type>
    </column>
    <column>
        <name>numproductos</name>
        <type>integer</type>
        <null>NO</null>
        <default>0</default>
    </column>
    <constraint>
        <name>familias_pkey</name>
        <type>PRIMARY KEY (codfamilia)</type>
    </constraint>
<column>
        <name>pos_shortcut</name>
        <type>boolean</type>
    </column><column>
        <name>pos_idlogo</name>
        <type>integer</type>
    </column><constraint>
        <name>ca_pos_familias_attached_files</name>
        <type>FOREIGN KEY (pos_idlogo) REFERENCES attached_files (idfile) ON DELETE SET NULL ON UPDATE CASCADE</type>
    </constraint></table>
